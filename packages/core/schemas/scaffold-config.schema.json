{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": ".github/scaffold-config.yml",
  "type": "object",
  "additionalProperties": false,
  "required": ["stages", "approvers", "gherkin", "ci_workflows", "max_in_flight", "max_stack_prs", "warn_open_prs_per_developer", "max_rework_rounds", "pr_size"],
  "properties": {
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intake": { "type": "boolean" },
        "plan": { "type": "boolean" },
        "implement": { "type": "boolean" },
        "review": { "type": "boolean" },
        "collaboration": { "type": "boolean" }
      }
    },
    "approvers": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 39 } },
    "flow_lead": { "type": "string", "maxLength": 39 },
    "gherkin": { "type": "string", "enum": ["off", "auto", "always"] },
    "ci_workflows": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 200 } },
    "bdd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "artifact"],
      "properties": {
        "workflow": { "type": "string", "maxLength": 200 },
        "artifact": { "type": "string", "maxLength": 200 }
      }
    },
    "max_in_flight": { "type": "integer", "minimum": 1, "maximum": 100 },
    "max_stack_prs": { "type": "integer", "minimum": 1, "maximum": 10 },
    "warn_open_prs_per_developer": { "type": "integer", "minimum": 1, "maximum": 10 },
    "max_rework_rounds": { "type": "integer", "minimum": 1, "maximum": 10 },
    "pr_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["soft", "hard", "exempt"],
      "properties": {
        "soft": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "lines"],
          "properties": {
            "files": { "type": "integer", "minimum": 1 },
            "lines": { "type": "integer", "minimum": 1 }
          }
        },
        "hard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files", "lines"],
          "properties": {
            "files": { "type": "integer", "minimum": 1 },
            "lines": { "type": "integer", "minimum": 1 }
          }
        },
        "exempt": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 200 } }
      }
    }
  }
}
