{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conflict-check output",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": { "type": "string", "maxLength": 500 },
    "findings": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["with", "kind", "spec", "explanation"],
        "properties": {
          "with": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "integer", "minimum": 1 } },
          "kind": { "type": "string", "enum": ["conflict", "regression-risk"] },
          "spec": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 200 } },
          "explanation": { "type": "string", "maxLength": 800 }
        }
      }
    }
  }
}
